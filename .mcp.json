{
  "mcpServers": {
    "shopify-dev-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@shopify/dev-mcp@latest"],
      "env": {}
    },
    "shopify-admin": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "-p", "@kockatoos/shopify-mcp", "kockatoos-shopify-mcp"],
      "env": {
        "SHOPIFY_STORE_NAME": "zuppi-p2gvdg5e",
        "SHOPIFY_CLIENT_ID": "${SHOPIFY_CLIENT_ID}",
        "SHOPIFY_CLIENT_SECRET": "${SHOPIFY_CLIENT_SECRET}"
      }
    }
  }
}
