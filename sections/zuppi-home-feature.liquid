{% comment %}
  Section contract. Renders the editable Zuppi homepage hero, category cards, or promotion.
{% endcomment %}

{% liquid
  assign options = section.settings
  assign destination = options.link | default: routes.all_products_collection_url
  assign media_alt = options.image.alt | default: ''
%}

{% case options.presentation %}
  {% when 'hero' %}
    {% liquid
      assign poster_url = 'zuppi-hero.webp' | asset_url
      if options.image != blank
        assign poster_url = options.image | image_url: width: 1800
      elsif options.video.preview_image != blank
        assign poster_url = options.video.preview_image | image_url: width: 1800
      endif
    %}
    <zuppi-hero-video class="zuppi-feature zuppi-feature--hero">
      <video class="zuppi-feature__video" muted loop playsinline preload="none" poster="{{ poster_url | escape }}" aria-hidden="true">
        {% if options.video != blank %}
          {% for source in options.video.sources %}
            {% if source.format == 'mp4' %}<source src="{{ source.url | escape }}" type="{{ source.mime_type | escape }}">{% endif %}
          {% endfor %}
        {% else %}
          <source src="{{ 'zuppi-hero.mp4' | asset_url }}" type="video/mp4">
        {% endif %}
      </video>
      <div class="zuppi-feature__copy">
        {% if options.heading != blank %}<h1>{{ options.heading | escape }}</h1>{% endif %}
        {% if options.description != blank %}<div class="zuppi-feature__description rte">{{ options.description }}</div>{% endif %}
        {% if options.label != blank %}<a class="zuppi-feature__button" href="{{ destination }}">{{ options.label | escape }}</a>{% endif %}
      </div>
    </zuppi-hero-video>

  {% when 'categories' %}
    <div class="zuppi-feature zuppi-feature--categories">
      {% if options.heading != blank %}<h2>{{ options.heading | escape }}</h2>{% endif %}
      {% if section.blocks.size > 0 %}
        <ul class="zuppi-feature__categories list-unstyled">
          {% for block in section.blocks %}
            {% liquid
              assign collection_handle = block.settings.title | handleize
              assign category = block.settings.collection | default: collections[collection_handle]
              assign collection_handle = category.handle | default: collection_handle
              assign category_title = block.settings.title | default: category.title
              assign category_image = block.settings.image
              assign category_url = category.url | default: routes.all_products_collection_url
              assign tile = 'zuppi-' | append: collection_handle | append: '.webp'
            %}
            {% if category_title != blank %}
              <li {{ block.shopify_attributes }}>
                <a class="zuppi-feature__category" href="{{ category_url }}">
                  {% if category_image != blank %}
                    {{ category_image | image_url: width: 520 | image_tag: widths: '190, 300, 420, 520', sizes: '(min-width: 1100px) 16vw, (min-width: 600px) 30vw, 45vw', loading: 'lazy', alt: '' }}
                  {% elsif collection_handle == 'dogs' or collection_handle == 'cats' or collection_handle == 'fish' or collection_handle == 'birds' or collection_handle == 'small-pets' or collection_handle == 'reptiles' %}
                    <img src="{{ tile | asset_url }}" width="420" height="420" loading="lazy" alt="">
                  {% elsif category.featured_image != blank %}
                    {{ category.featured_image | image_url: width: 520 | image_tag: widths: '190, 300, 420, 520', loading: 'lazy', alt: '' }}
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {% endif %}
                  <span class="zuppi-feature__category-copy">
                    <span class="zuppi-feature__category-title">{{ category_title | escape }}</span>
                    {% if block.settings.description != blank %}
                      <span class="zuppi-feature__category-reveal">
                        <span class="zuppi-feature__category-detail"><span>{{ block.settings.description | escape }}</span></span>
                      </span>
                    {% endif %}
                  </span>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>

  {% when 'promotion' %}
    <div class="zuppi-feature zuppi-feature--promotion">
      <div class="zuppi-feature__copy">
        {% if options.heading != blank %}<h2>{{ options.heading | escape }}</h2>{% endif %}
        {% if options.description != blank %}<div class="zuppi-feature__description rte">{{ options.description }}</div>{% endif %}
        {% if options.label != blank %}<a class="zuppi-feature__button" href="{{ destination }}">{{ options.label | escape }}</a>{% endif %}
      </div>
      {% if options.image != blank %}
        {{ options.image | image_url: width: 1600 | image_tag: widths: '420, 680, 960, 1280, 1600', sizes: '(min-width: 750px) 54vw, 100vw', loading: 'lazy', alt: media_alt }}
      {% else %}
        <img src="{{ 'zuppi-promotion.webp' | asset_url }}" width="1440" height="720" loading="lazy" alt="">
      {% endif %}
    </div>
{% endcase %}

{% stylesheet %}
  .zuppi-feature {
    --zuppi-ink: #1E1B4B;
    --zuppi-paper: #fff9ef;
    --zuppi-gutter: clamp(1rem, 4vw, 4rem);
  }

  .zuppi-feature h1, .zuppi-feature h2 {
    color: inherit;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: -.045em;
    line-height: .99;
    margin: 0;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .zuppi-feature--hero {
    display: grid;
    position: relative;
    isolation: isolate;
    align-items: end;
    min-block-size: clamp(27rem, 68svh, 46rem);
    background: #384634;
    color: #fff9ef;
  }

  .zuppi-feature__video, .zuppi-feature--hero::after {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    z-index: -1;
  }

  .zuppi-feature__video { object-fit: cover; object-position: center 55%; }
  .zuppi-feature--hero::after {
    content: '';
    background: linear-gradient(90deg, #201629c9, #20162938 66%, #20162908), linear-gradient(0deg, #20162969, transparent 50%);
    pointer-events: none;
  }

  .zuppi-feature__copy { padding: clamp(2rem, 6vw, 6rem) var(--zuppi-gutter); }
  .zuppi-feature--hero h1 { max-inline-size: 13ch; font-size: clamp(3rem, 7.5vw, 7rem); }
  .zuppi-feature__description { max-inline-size: 37ch; margin-block: 1rem 1.55rem; }
  .zuppi-feature__description p { color: inherit; }
  .zuppi-feature__button {
    display: inline-flex;
    min-block-size: 46px;
    align-items: center;
    padding: .65rem 1.4rem;
    border: 1px solid transparent;
    border-radius: 99px;
    background: var(--zuppi-paper);
    color: var(--zuppi-ink);
    font-weight: 650;
    text-decoration: none;
  }

  .zuppi-feature__button:hover { background: #f5d5bf; }
  .zuppi-feature--categories { padding: clamp(2.4rem, 5vw, 5rem) var(--zuppi-gutter); color: var(--zuppi-ink); background: #faf5ef; }
  .zuppi-feature h2 { font-size: clamp(2.25rem, 4.6vw, 4.25rem); }
  .zuppi-feature__categories {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(.7rem, 1.5vw, 1.5rem);
    margin: 1.65rem 0 0;
    padding: 0;
  }

  .zuppi-feature__category {
    position: relative;
    isolation: isolate;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.1rem;
    color: #fff9ef;
    background: #321e31;
    text-decoration: none;
  }

  .zuppi-feature__category > :is(img, svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .zuppi-feature__category::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #21162be6, #21162b52 42%, transparent 72%);
    pointer-events: none;
    content: '';
  }

  .zuppi-feature__category-copy {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    display: block;
    padding: clamp(.7rem, 1.4vw, 1.25rem);
  }

  .zuppi-feature__category-title {
    display: block;
    font-size: clamp(1.05rem, 1.9vw, 1.7rem);
    line-height: 1.08;
    font-weight: 750;
    letter-spacing: -.025em;
  }

  .zuppi-feature__category-reveal { display: grid; grid-template-rows: 1fr; }
  .zuppi-feature__category-detail { min-block-size: 0; overflow: hidden; }
  .zuppi-feature__category-detail > span { display: block; padding-block-start: .42rem; font-size: clamp(.75rem, 1vw, .9rem); line-height: 1.35; }
  .zuppi-feature__category:focus-visible { outline: 2px solid #4f46e5; outline-offset: 3px; }

  @media (min-width: 750px) and (hover: hover) and (pointer: fine) {
    .zuppi-feature__category-reveal { grid-template-rows: 0fr; }
    .zuppi-feature__category-detail { opacity: 0; translate: 0 .4rem; }
    .zuppi-feature__category:is(:hover, :focus-visible) .zuppi-feature__category-reveal { grid-template-rows: 1fr; }
    .zuppi-feature__category:is(:hover, :focus-visible) .zuppi-feature__category-detail { opacity: 1; translate: 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .zuppi-feature__category > img { transition: scale .55s cubic-bezier(.22,.65,.25,1); }
    .zuppi-feature__category-reveal { transition: grid-template-rows .36s cubic-bezier(.22,.65,.25,1); }
    .zuppi-feature__category-detail { transition: opacity .32s ease, translate .36s ease; }
    .zuppi-feature__category:is(:hover, :focus-visible) > img { scale: 1.06; }
  }
  .zuppi-feature--promotion {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    margin: clamp(1.5rem, 4vw, 4rem) 0;
    overflow: hidden;
    align-items: stretch;
    color: var(--zuppi-paper);
    background: var(--zuppi-ink);
  }

  .zuppi-feature--promotion .zuppi-feature__copy { align-self: center; }
  .zuppi-feature--promotion > img { inline-size: 100%; block-size: 100%; min-block-size: 17rem; object-fit: cover; object-position: 66% center; }

  @media (max-width: 989px) { .zuppi-feature__categories { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 599px) {
    .zuppi-feature--hero { min-block-size: 30rem; }
    .zuppi-feature__categories { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .zuppi-feature--promotion { grid-template-columns: minmax(0, 1fr); }
    .zuppi-feature--promotion > img { min-block-size: 0; aspect-ratio: 1.45; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('zuppi-hero-video')) {
    customElements.define('zuppi-hero-video', class extends HTMLElement {
      connectedCallback() {
        const video = this.querySelector('video');
        if (!video) return;

        this.listeners?.abort();
        this.listeners = new AbortController();
        const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const updatePlayback = () => {
          if (motion.matches) {
            video.pause();
          } else {
            video.play().catch(() => {});
          }
        };
        motion.addEventListener('change', updatePlayback, { signal: this.listeners.signal });
        updatePlayback();
      }

      disconnectedCallback() { this.listeners?.abort(); }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:names.hero",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "select", "id": "presentation", "label": "t:settings.layout", "default": "hero", "options": [
      { "value": "hero", "label": "t:names.hero" },
      { "value": "categories", "label": "t:names.collection_list" },
      { "value": "promotion", "label": "t:names.image_with_text" }
    ] },
    { "type": "text", "id": "heading", "label": "t:settings.heading" },
    { "type": "richtext", "id": "description", "label": "t:names.description", "visible_if": "{{ section.settings.presentation != 'categories' }}" },
    { "type": "text", "id": "label", "label": "t:settings.label", "visible_if": "{{ section.settings.presentation != 'categories' }}" },
    { "type": "url", "id": "link", "label": "t:settings.link", "visible_if": "{{ section.settings.presentation != 'categories' }}" },
    { "type": "image_picker", "id": "image", "label": "t:settings.image", "visible_if": "{{ section.settings.presentation != 'categories' }}" },
    { "type": "video", "id": "video", "label": "t:settings.video", "visible_if": "{{ section.settings.presentation == 'hero' }}" }
  ],
  "blocks": [
    { "type": "category", "name": "t:names.collection", "settings": [
      { "type": "collection", "id": "collection", "label": "t:settings.collection" },
      { "type": "text", "id": "title", "label": "t:settings.heading" },
      { "type": "text", "id": "description", "label": "t:names.description" },
      { "type": "image_picker", "id": "image", "label": "t:settings.image" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "t:names.hero", "settings": { "presentation": "hero", "heading": "Good days have paws.", "label": "Shop pet essentials" } },
    { "name": "t:names.collection_list", "settings": { "presentation": "categories", "heading": "Shop by pet" }, "blocks": [
      { "type": "category", "settings": { "title": "Dogs" } },
      { "type": "category", "settings": { "title": "Cats" } }
    ] },
    { "name": "t:names.image_with_text", "settings": { "presentation": "promotion", "heading": "Little things. Big tail wags.", "label": "Explore pet essentials" } }
  ]
}
{% endschema %}
