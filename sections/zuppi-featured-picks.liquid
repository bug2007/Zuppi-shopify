{% comment %}
  Section contract. Shows a merchant-selected set of products in a compact homepage grid.
{% endcomment %}

{% assign featured_products = section.settings.products %}
{% if featured_products != blank %}
  <div class="zuppi-picks{% if featured_products.count > 1 %} zuppi-picks--loop{% endif %}" style="--pick-columns: {{ featured_products.count | at_most: 4 }};">
    <div class="zuppi-picks__header">
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.link_label != blank %}
        <a class="zuppi-picks__view-all" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </div>
    {% capture cards %}
    <ul class="zuppi-picks__grid list-unstyled">
      {% for product in featured_products limit: 4 %}
        <li class="zuppi-picks__item">
          <a href="{{ product.url }}" class="zuppi-picks__card">
            <div class="zuppi-picks__image">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 680 | image_tag: widths: '160, 240, 360, 480, 680', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: '' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="zuppi-picks__details">
              <div>
                <h3>{{ product.title | escape }}</h3>
                {% render 'price', product_resource: product, show_sale_price_first: true %}
              </div>
              <span class="zuppi-picks__arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        </li>
      {% endfor %}
    </ul>
    {% endcapture %}
    {% if featured_products.count > 1 %}
      <div class="zuppi-picks__control">
        <input type="checkbox" id="ZuppiPicksPause-{{ section.id }}">
        <label for="ZuppiPicksPause-{{ section.id }}">{{ 'accessibility.slideshow_pause' | t }}</label>
      </div>
    {% endif %}
    <div class="zuppi-picks__viewport">
      <div class="zuppi-picks__track">
        {{ cards }}
        {% if featured_products.count > 1 %}
          <div class="zuppi-picks__copy" aria-hidden="true">
            {{ cards | replace: 'class="zuppi-picks__card"', 'class="zuppi-picks__card" tabindex="-1"' }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .zuppi-picks {
    --zuppi-picks-ink: #1e1b4b;
    --zuppi-picks-accent: #4f46e5;
    --zuppi-picks-gap: clamp(.65rem, 1.6vw, 1.5rem);
    padding: clamp(2rem, 4vw, 4rem) clamp(1rem, 4vw, 4rem);
    background: #f1edff;
    color: var(--zuppi-picks-ink);
  }

  .zuppi-picks__header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .6rem 1rem; margin-block-end: 1.5rem; }
  .zuppi-picks__header h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.8rem); line-height: 1; letter-spacing: -.04em; color: inherit; }
  .zuppi-picks__view-all { color: inherit; font-weight: 650; text-underline-offset: .22em; }
  .zuppi-picks__grid { display: grid; grid-template-columns: repeat(var(--pick-columns), minmax(0, 1fr)); gap: var(--zuppi-picks-gap); margin: 0; padding: 0; }
  .zuppi-picks__copy, .zuppi-picks__control { display: none; }
  .zuppi-picks__viewport { container-type: inline-size; }
  .zuppi-picks__card { display: block; height: 100%; overflow: hidden; border-radius: 1.2rem; background: #fffaf4; color: inherit; text-decoration: none; }
  .zuppi-picks__card:focus-visible { outline: 2px solid var(--zuppi-picks-accent); outline-offset: 3px; }
  .zuppi-picks__image { display: grid; overflow: hidden; aspect-ratio: 1.14; background: #f5f1ee; }
  .zuppi-picks__image > :is(img, svg) { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .zuppi-picks__details { display: flex; align-items: flex-start; justify-content: space-between; gap: .45rem; padding: clamp(.65rem, 1.25vw, 1.15rem); }
  .zuppi-picks__details h3 { margin: 0 0 .35rem; font-size: clamp(.86rem, 1.2vw, 1.1rem); font-weight: 700; line-height: 1.2; color: inherit; }
  .zuppi-picks__arrow { display: grid; flex: 0 0 1.8rem; aspect-ratio: 1; place-items: center; border-radius: 50%; color: var(--zuppi-picks-accent); background: #ebe6ff; }
  .zuppi-picks__card:hover .zuppi-picks__arrow { color: #fff; background: var(--zuppi-picks-accent); }

  @media (max-width: 749px) { .zuppi-picks__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  @media (prefers-reduced-motion: no-preference) {
    .zuppi-picks__image img, .zuppi-picks__arrow { transition: transform .36s cubic-bezier(.2,.7,.3,1); }
    .zuppi-picks__card:is(:hover, :focus-visible) .zuppi-picks__image img { transform: scale(1.055); }
    .zuppi-picks__card:is(:hover, :focus-visible) .zuppi-picks__arrow { transform: translate(2px, -2px); }

    @supports (width: 1cqw) {
      .zuppi-picks--loop .zuppi-picks__control { display: flex; align-items: center; gap: .4rem; margin-block-end: .85rem; }
      .zuppi-picks--loop .zuppi-picks__control input { accent-color: var(--zuppi-picks-accent); }
      .zuppi-picks--loop .zuppi-picks__control label { font-size: .85rem; cursor: pointer; }
      .zuppi-picks--loop .zuppi-picks__viewport { overflow: clip; }
      .zuppi-picks--loop .zuppi-picks__track { display: flex; width: max-content; animation: zuppi-picks-loop 28s linear infinite; }
      .zuppi-picks--loop .zuppi-picks__copy { display: block; }
      .zuppi-picks--loop .zuppi-picks__grid {
        display: flex;
        padding-inline-end: var(--zuppi-picks-gap);
      }
      .zuppi-picks--loop .zuppi-picks__item {
        flex: 0 0 auto;
        width: calc((100cqw - (var(--pick-columns) - 1) * var(--zuppi-picks-gap)) / var(--pick-columns));
      }
      .zuppi-picks--loop:has(.zuppi-picks__control input:checked) .zuppi-picks__track,
      .zuppi-picks--loop .zuppi-picks__viewport:hover .zuppi-picks__track { animation-play-state: paused; }
      .zuppi-picks--loop .zuppi-picks__viewport:has(.zuppi-picks__card:focus-visible) .zuppi-picks__track {
        animation: none;
        width: 100%;
      }
      .zuppi-picks--loop .zuppi-picks__viewport:has(.zuppi-picks__card:focus-visible) .zuppi-picks__track > .zuppi-picks__grid {
        display: grid;
        width: 100%;
        padding-inline-end: 0;
      }
      .zuppi-picks--loop .zuppi-picks__viewport:has(.zuppi-picks__card:focus-visible) :is(.zuppi-picks__item, .zuppi-picks__copy) { width: auto; }
      .zuppi-picks--loop .zuppi-picks__viewport:has(.zuppi-picks__card:focus-visible) .zuppi-picks__copy { display: none; }

      @media (max-width: 749px) {
        .zuppi-picks--loop .zuppi-picks__item { width: calc((100cqw - var(--zuppi-picks-gap)) / 2); }
      }
    }
  }

  @keyframes zuppi-picks-loop { to { transform: translateX(-50%); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.featured_collection",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "The Zuppi edit" },
    { "type": "product_list", "id": "products", "label": "t:settings.products", "limit": 4 },
    { "type": "text", "id": "link_label", "label": "t:settings.label", "default": "Shop all products" },
    { "type": "url", "id": "link", "label": "t:settings.link" }
  ],
  "presets": [{ "name": "t:names.featured_collection" }]
}
{% endschema %}
