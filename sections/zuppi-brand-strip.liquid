{% comment %}
  Section contract. Displays editable brand or product-line links in a strip that can scroll continuously.
  @example
  <!-- Add "Brand carousel" to the home page, then add one Brand block per brand -->
{% endcomment %}

{% if section.blocks.size > 0 %}
  {% liquid
    assign settings_s = section.settings

    assign is_loop = false
    if settings_s.auto_scroll and section.blocks.size > 1
      assign is_loop = true
    endif
  %}

  {% capture tiles %}
    {% for block in section.blocks %}
      {% if block.settings.title == blank %}{% continue %}{% endif %}
      <li
        class="zuppi-brands__tile"
        {% if block.settings.tile_color != blank %}style="--zb-tile-override: {{ block.settings.tile_color }};"{% endif %}
        {{ block.shopify_attributes }}
      >
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="zuppi-brands__label">
        {% else %}
          <span class="zuppi-brands__label">
        {% endif %}
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 320, 450, 600', sizes: '300px', loading: 'lazy', alt: block.settings.title }}
        {% else %}
          {{ block.settings.title | escape }}
        {% endif %}
        {% if block.settings.link != blank %}</a>{% else %}</span>{% endif %}
      </li>
    {% endfor %}
  {% endcapture %}

  <div
    class="zuppi-brands{% if is_loop %} zuppi-brands--loop{% endif %}{% if settings_s.pause_on_hover %} zuppi-brands--pause{% endif %}{% if settings_s.alternate_tile_colors %} zuppi-brands--alternate{% endif %}"
    style="
      --zb-background: {{ settings_s.background_color | default: 'transparent' }};
      --zb-heading-color: {{ settings_s.heading_color | default: 'var(--color-foreground)' }};
      --zb-tile-bg: {{ settings_s.tile_color_1 | default: 'transparent' }};
      --zb-tile-bg-2: {{ settings_s.tile_color_2 | default: 'transparent' }};
      --zb-tile-bg-3: {{ settings_s.tile_color_3 | default: 'transparent' }};
      --zb-text: {{ settings_s.tile_text_color | default: 'var(--color-foreground)' }};
      --zb-border: {{ settings_s.tile_border_color | default: 'transparent' }};
      --zb-hover-border: {{ settings_s.tile_hover_border_color | default: 'var(--color-foreground)' }};
      --zb-border-width: {{ settings_s.tile_border_width }}px;
      --zb-radius: {{ settings_s.tile_radius }}px;
      --zb-gap: {{ settings_s.tile_gap }}px;
      --zb-tile-width: {{ settings_s.tile_width }}px;
      --zb-tile-width-mobile: {{ settings_s.tile_width_mobile }}px;
      --zb-tile-height: {{ settings_s.tile_height }}px;
      --zb-tile-height-mobile: {{ settings_s.tile_height_mobile }}px;
      --zb-logo-height: {{ settings_s.logo_height }}px;
      --zb-font: var(--font-{{ settings_s.tile_font }}--family);
      --zb-font-size: {{ settings_s.tile_font_size }}px;
      --zb-font-weight: {{ settings_s.tile_font_weight }};
      --zb-heading-gap: {{ settings_s.heading_gap }}px;
      --zb-heading-align: {{ settings_s.heading_alignment }};
      --zb-padding-top: {{ settings_s.padding-block-start }}px;
      --zb-padding-bottom: {{ settings_s.padding-block-end }}px;
      --zb-padding-desktop: {{ settings_s.padding-inline-desktop }}px;
      --zb-padding-tablet: {{ settings_s.padding-inline-tablet }}px;
      --zb-padding-mobile: {{ settings_s.padding-inline-mobile }}px;
      --zb-duration: {{ settings_s.loop_duration }}s;
      --zb-direction: {% if settings_s.scroll_direction == 'right' %}reverse{% else %}normal{% endif %};
    "
  >
    <div class="zuppi-brands__inner{% if settings_s.section_width == 'page-width' %} zuppi-brands__inner--page{% endif %}">
      {% if settings_s.heading != blank %}
        <div class="zuppi-brands__header">
          <h2 class="zuppi-brands__heading {{ settings_s.heading_size }}">{{ settings_s.heading | escape }}</h2>
        </div>
      {% endif %}
      <div class="zuppi-brands__viewport">
        <div class="zuppi-brands__track">
          <ul class="zuppi-brands__list list-unstyled">{{ tiles }}</ul>
          {% if is_loop %}
            <ul class="zuppi-brands__list zuppi-brands__copy list-unstyled" aria-hidden="true">
              {% for block in section.blocks %}
                {% if block.settings.title == blank %}{% continue %}{% endif %}
                <li
                  class="zuppi-brands__tile"
                  {% if block.settings.tile_color != blank %}style="--zb-tile-override: {{ block.settings.tile_color }};"{% endif %}
                >
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" class="zuppi-brands__label" tabindex="-1">
                  {% else %}
                    <span class="zuppi-brands__label">
                  {% endif %}
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 320, 450, 600', sizes: '300px', loading: 'lazy', alt: '' }}
                  {% else %}
                    {{ block.settings.title | escape }}
                  {% endif %}
                  {% if block.settings.link != blank %}</a>{% else %}</span>{% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .zuppi-brands {
    padding: var(--zb-padding-top) var(--zb-padding-mobile) var(--zb-padding-bottom);
    background: var(--zb-background);
  }

  .zuppi-brands__inner--page {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .zuppi-brands__header {
    margin-block-end: var(--zb-heading-gap);
    text-align: var(--zb-heading-align);
  }

  .zuppi-brands .zuppi-brands__heading {
    margin: 0;
    color: var(--zb-heading-color);
  }

  .zuppi-brands__viewport {
    container-type: inline-size;
  }

  .zuppi-brands__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--zb-gap);
    margin: 0;
    padding: 0;
  }

  .zuppi-brands__copy {
    display: none;
  }

  .zuppi-brands__tile {
    display: flex;
    inline-size: var(--zb-tile-width-mobile);
  }

  .zuppi-brands__label {
    display: grid;
    place-items: center;
    inline-size: 100%;
    min-block-size: var(--zb-tile-height-mobile);
    padding: var(--padding-xs);
    border: var(--zb-border-width) solid var(--zb-border);
    border-radius: var(--zb-radius);
    background: var(--zb-tile-override, var(--zb-tile-bg));
    color: var(--zb-text);
    font-family: var(--zb-font);
    font-size: var(--zb-font-size);
    font-weight: var(--zb-font-weight);
    text-align: center;
    text-decoration: none;
  }

  .zuppi-brands--alternate .zuppi-brands__tile:nth-child(3n + 2) .zuppi-brands__label {
    background: var(--zb-tile-override, var(--zb-tile-bg-2));
  }

  .zuppi-brands--alternate .zuppi-brands__tile:nth-child(3n) .zuppi-brands__label {
    background: var(--zb-tile-override, var(--zb-tile-bg-3));
  }

  .zuppi-brands__label img {
    width: 90%;
    height: auto;
    max-height: var(--zb-logo-height);
    object-fit: contain;
  }

  a.zuppi-brands__label:hover {
    border-color: var(--zb-hover-border);
  }

  .zuppi-brands__label:focus-visible {
    outline: 2px solid var(--zb-hover-border);
    outline-offset: -3px;
  }

  @media screen and (min-width: 750px) {
    .zuppi-brands {
      padding-inline: var(--zb-padding-tablet);
    }

    .zuppi-brands__tile {
      inline-size: var(--zb-tile-width);
    }

    .zuppi-brands__label {
      min-block-size: var(--zb-tile-height);
    }
  }

  @media screen and (min-width: 990px) {
    .zuppi-brands {
      padding-inline: var(--zb-padding-desktop);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (width: 1cqw) {
      .zuppi-brands--loop .zuppi-brands__viewport {
        overflow: hidden;
      }

      .zuppi-brands--loop .zuppi-brands__track {
        display: flex;
        inline-size: max-content;
        animation: zuppi-brand-loop var(--zb-duration) linear infinite var(--zb-direction);
      }

      .zuppi-brands--loop .zuppi-brands__list {
        flex: 0 0 auto;
        flex-wrap: nowrap;
        min-inline-size: 100cqw;
        padding-inline-end: var(--zb-gap);
      }

      .zuppi-brands--loop .zuppi-brands__tile {
        flex: 1 0 auto;
      }

      .zuppi-brands--loop .zuppi-brands__copy {
        display: flex;
      }

      .zuppi-brands--loop.zuppi-brands--pause .zuppi-brands__viewport:hover .zuppi-brands__track {
        animation-play-state: paused;
      }

      .zuppi-brands--loop .zuppi-brands__viewport:has(:focus-visible) {
        overflow-x: auto;
      }

      .zuppi-brands--loop .zuppi-brands__viewport:has(:focus-visible) .zuppi-brands__track {
        animation: none;
      }

      .zuppi-brands--loop .zuppi-brands__viewport:has(:focus-visible) .zuppi-brands__copy {
        display: none;
      }
    }
  }

  @keyframes zuppi-brand-loop {
    to {
      transform: translateX(-50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.brand_carousel",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "t:content.heading" },
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "Shop by brand" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings.heading_size",
      "options": [
        { "value": "h1", "label": "t:options.h1" },
        { "value": "h2", "label": "t:options.h2" },
        { "value": "h3", "label": "t:options.h3" },
        { "value": "h4", "label": "t:options.h4" }
      ],
      "default": "h2"
    },
    { "type": "text_alignment", "id": "heading_alignment", "label": "t:settings.alignment", "default": "left" },
    { "type": "range", "id": "heading_gap", "label": "t:settings.heading_spacing", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "color", "id": "heading_color", "label": "t:settings.heading_color", "default": "{{ settings.color_palette.foreground }}" },

    { "type": "header", "content": "t:content.brand_tiles" },
    { "type": "range", "id": "tile_width", "label": "t:settings.tile_width", "min": 100, "max": 320, "step": 4, "unit": "px", "default": 200 },
    { "type": "range", "id": "tile_width_mobile", "label": "t:settings.tile_width_mobile", "min": 80, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "tile_height", "label": "t:settings.tile_height", "min": 48, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "tile_height_mobile", "label": "t:settings.tile_height_mobile", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 68 },
    { "type": "range", "id": "tile_gap", "label": "t:settings.gap", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "tile_radius", "label": "t:settings.corner_radius", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "tile_border_width", "label": "t:settings.tile_border_width", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "logo_height", "label": "t:settings.logo_max_height", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 56 },

    { "type": "header", "content": "t:content.typography" },
    {
      "type": "select",
      "id": "tile_font",
      "label": "t:settings.font",
      "options": [
        { "value": "body", "label": "t:options.body" },
        { "value": "subheading", "label": "t:options.subheading" },
        { "value": "heading", "label": "t:options.heading" },
        { "value": "accent", "label": "t:options.accent" }
      ],
      "default": "heading"
    },
    { "type": "range", "id": "tile_font_size", "label": "t:settings.size", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 18 },
    {
      "type": "select",
      "id": "tile_font_weight",
      "label": "t:settings.tile_font_weight",
      "options": [
        { "value": "400", "label": "t:options.weight_regular" },
        { "value": "500", "label": "t:options.weight_medium" },
        { "value": "700", "label": "t:options.weight_bold" }
      ],
      "default": "400"
    },

    { "type": "header", "content": "t:content.colors" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "default": "{{ settings.color_palette.background }}" },
    { "type": "color", "id": "tile_text_color", "label": "t:settings.text_color", "default": "{{ settings.color_palette.foreground }}" },
    { "type": "color", "id": "tile_color_1", "label": "t:settings.tile_color", "default": "{{ settings.color_palette.color3 }}" },
    { "type": "checkbox", "id": "alternate_tile_colors", "label": "t:settings.alternate_tile_colors", "default": false },
    { "type": "color", "id": "tile_color_2", "label": "t:settings.tile_color_2", "default": "{{ settings.color_palette.color2 }}", "visible_if": "{{ section.settings.alternate_tile_colors }}" },
    { "type": "color", "id": "tile_color_3", "label": "t:settings.tile_color_3", "default": "{{ settings.color_palette.background }}", "visible_if": "{{ section.settings.alternate_tile_colors }}" },
    { "type": "color", "id": "tile_border_color", "label": "t:settings.tile_border_color", "default": "{{ settings.color_palette.color2 }}" },
    { "type": "color", "id": "tile_hover_border_color", "label": "t:settings.tile_hover_border_color", "default": "{{ settings.color_palette.color1 }}" },

    { "type": "header", "content": "t:content.motion" },
    { "type": "checkbox", "id": "auto_scroll", "label": "t:settings.auto_scroll", "default": true },
    { "type": "range", "id": "loop_duration", "label": "t:settings.loop_duration", "info": "t:info.loop_duration", "min": 10, "max": 90, "step": 2, "unit": "s", "default": 34, "visible_if": "{{ section.settings.auto_scroll }}" },
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "t:settings.scroll_direction",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.auto_scroll }}"
    },
    { "type": "checkbox", "id": "pause_on_hover", "label": "t:settings.pause_on_hover", "default": true, "visible_if": "{{ section.settings.auto_scroll }}" },

    { "type": "header", "content": "t:content.section_layout" },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "full-width"
    },

    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-inline-desktop", "label": "t:settings.padding_inline_desktop", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding-inline-tablet", "label": "t:settings.padding_inline_tablet", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding-inline-mobile", "label": "t:settings.padding_inline_mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 10 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:names.brand",
      "settings": [
        { "type": "text", "id": "title", "label": "t:settings.brand_name" },
        { "type": "image_picker", "id": "image", "label": "t:settings.image" },
        { "type": "url", "id": "link", "label": "t:settings.link" },
        { "type": "color", "id": "tile_color", "label": "t:settings.tile_color_override" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "t:names.brand_carousel" }]
}
{% endschema %}
