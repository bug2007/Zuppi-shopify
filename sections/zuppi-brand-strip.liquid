{% comment %}
  Section contract. Displays editable brand or product-line links in a continuously scrolling strip.
{% endcomment %}

{% if section.blocks.size > 0 %}
  {% capture tiles %}
    {% for block in section.blocks %}
      {% if block.settings.title == blank %}{% continue %}{% endif %}
      <li class="zuppi-brands__tile" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="zuppi-brands__label">
        {% else %}
          <span class="zuppi-brands__label">
        {% endif %}
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 320 | image_tag: widths: '120, 200, 320', sizes: '160px', loading: 'lazy', alt: block.settings.title }}
        {% else %}
          {{ block.settings.title | escape }}
        {% endif %}
        {% if block.settings.link != blank %}</a>{% else %}</span>{% endif %}
      </li>
    {% endfor %}
  {% endcapture %}

  <div class="zuppi-brands{% if section.blocks.size > 1 %} zuppi-brands--loop{% endif %}">
    <div class="zuppi-brands__header">
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    <div class="zuppi-brands__viewport">
      <div class="zuppi-brands__track">
        <ul class="zuppi-brands__list list-unstyled">{{ tiles }}</ul>
        {% if section.blocks.size > 1 %}
          <ul class="zuppi-brands__list zuppi-brands__copy list-unstyled" aria-hidden="true">
            {% for block in section.blocks %}
              {% if block.settings.title == blank %}{% continue %}{% endif %}
              <li class="zuppi-brands__tile">
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="zuppi-brands__label" tabindex="-1">
                {% else %}
                  <span class="zuppi-brands__label">
                {% endif %}
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 320 | image_tag: widths: '120, 200, 320', sizes: '160px', loading: 'lazy', alt: '' }}
                {% else %}
                  {{ block.settings.title | escape }}
                {% endif %}
                {% if block.settings.link != blank %}</a>{% else %}</span>{% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .zuppi-brands {
    --zuppi-brand-gap: clamp(.65rem, 1.35vw, 1.1rem);
    padding: clamp(2rem, 4vw, 4rem) clamp(1rem, 4vw, 4rem);
    background: #fff8f0;
    color: #1e1b4b;
  }

  .zuppi-brands__header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: .8rem; margin-block-end: 1.4rem; }
  .zuppi-brands h2 { margin: 0; font-size: clamp(2rem, 3.8vw, 3.5rem); letter-spacing: -.04em; line-height: 1; color: inherit; }
  .zuppi-brands__viewport { container-type: inline-size; }
  .zuppi-brands__list { display: flex; flex-wrap: wrap; gap: var(--zuppi-brand-gap); margin: 0; padding: 0; }
  .zuppi-brands__copy { display: none; }
  .zuppi-brands__tile { inline-size: clamp(8.25rem, 16vw, 14rem); }
  .zuppi-brands__label {
    display: grid;
    place-items: center;
    min-block-size: clamp(4.1rem, 7vw, 6.5rem);
    padding: .7rem;
    border: 1px solid #1e1b4b17;
    border-radius: .55rem;
    background: #f3edff;
    color: #30275d;
    font-size: clamp(.95rem, 1.55vw, 1.35rem);
    font-weight: 750;
    text-align: center;
    text-decoration: none;
  }

  .zuppi-brands__tile:nth-child(3n + 2) .zuppi-brands__label { background: #fae9df; }
  .zuppi-brands__tile:nth-child(3n) .zuppi-brands__label { background: #e8f0e7; }
  .zuppi-brands__label img { width: 90%; max-height: 3.5rem; height: auto; object-fit: contain; }
  a.zuppi-brands__label:hover { border-color: #4f46e5; }
  .zuppi-brands__label:focus-visible { outline: 2px solid #4f46e5; outline-offset: -3px; }

  @media (prefers-reduced-motion: no-preference) {
    @supports (width: 1cqw) {
      .zuppi-brands--loop .zuppi-brands__viewport { overflow: hidden; }
      .zuppi-brands--loop .zuppi-brands__track { display: flex; inline-size: max-content; animation: zuppi-brand-loop 34s linear infinite; }
      .zuppi-brands--loop .zuppi-brands__list { flex: 0 0 auto; flex-wrap: nowrap; min-inline-size: 100cqw; padding-inline-end: var(--zuppi-brand-gap); }
      .zuppi-brands--loop .zuppi-brands__tile { flex: 1 0 auto; }
      .zuppi-brands--loop .zuppi-brands__copy { display: flex; }
      .zuppi-brands--loop .zuppi-brands__viewport:hover .zuppi-brands__track { animation-play-state: paused; }
      .zuppi-brands--loop .zuppi-brands__viewport:has(:focus-visible) { overflow-x: auto; }
      .zuppi-brands--loop .zuppi-brands__viewport:has(:focus-visible) .zuppi-brands__track { animation: none; }
      .zuppi-brands--loop .zuppi-brands__viewport:has(:focus-visible) .zuppi-brands__copy { display: none; }
    }
  }

  @keyframes zuppi-brand-loop { to { transform: translateX(-50%); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.carousel",
  "enabled_on": { "templates": ["index"] },
  "settings": [{ "type": "text", "id": "heading", "label": "t:settings.heading", "default": "Shop by brand" }],
  "blocks": [{ "type": "brand", "name": "t:names.logo", "settings": [
    { "type": "text", "id": "title", "label": "t:settings.heading" },
    { "type": "image_picker", "id": "image", "label": "t:settings.image" },
    { "type": "url", "id": "link", "label": "t:settings.link" }
  ] }],
  "max_blocks": 16,
  "presets": [{ "name": "t:names.carousel" }]
}
{% endschema %}
